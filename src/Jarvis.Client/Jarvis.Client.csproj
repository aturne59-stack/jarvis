<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- For the import table, shared with the SolidWorks add-in (ImportForm). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Jarvis</AssemblyName>
    <RootNamespace>Jarvis.Client</RootNamespace>
    <ApplicationIcon>..\..\assets\vault.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\vault.ico" Link="Assets\vault.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same import table as the SolidWorks pane's Import files. -->
    <Compile Include="..\Jarvis.SwAddin\ImportForm.cs" Link="Views\ImportForm.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 3D viewer for the STL previews the SolidWorks add-in saves (MIT licensed). -->
    <PackageReference Include="HelixToolkit.Core.Wpf" Version="2.25.0" />
  </ItemGroup>

</Project>
