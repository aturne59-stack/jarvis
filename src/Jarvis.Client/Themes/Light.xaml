<!--
    Jarvis's light colors. Themes/Modern.xaml holds the control styles and refers to these by name (DynamicResource),
    so the app switches between Light.xaml and Dark.xaml without restarting (Views/ThemeManager.cs).
    Both files must define the same names.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCE8FC" />
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#C9CFD7" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E9ECF1" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DDE2E8" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#AEB6C1" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C9D1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA3AE" />
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#7D8794" />
    <SolidColorBrush x:Key="ToolGlyphBrush" Color="#374151" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309" />
    <SolidColorBrush x:Key="TealBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="BannerInfoBrush" Color="#E3F2FD" />
    <SolidColorBrush x:Key="BannerWarningBrush" Color="#FFF3E0" />
    <SolidColorBrush x:Key="BannerErrorBrush" Color="#FFEBEE" />
</ResourceDictionary>
